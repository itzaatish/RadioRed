      "type": "bigint",
      "identity": true,
      "primaryKey": true
    },
    {
      "name": "external_id",
      "type": "text",
      "notNull": true,
      "unique": true
    },
    {
      "name": "audio_path",
      "type": "text",
      "notNull": true
    },
    {
      "name": "duration_seconds",
      "type": "integer",
      "notNull": true
    },
    {
      "name": "transcript",
      "type": "text"
    },
    {
      "name": "next_frame_id",
      "type": "bigint",
      "references": "public.frames(id)"
    },
    {
      "name": "metadata",
      "type": "jsonb",
      "notNull": true,
      "default": "'{}'"
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "notNull": true,
      "default": "now()"
    }
  ],
  "indexes": [
    {
      "columns": ["next_frame_id"]
    },
    {
      "columns": ["created_at"]
    }
  ],
  "rls": false
}