# Objective: List the server-only environment variables required for Supabase, Azure AI, and the radio engine.
# Obtain these from Supabase Dashboard -> Connect / Settings -> API Keys.
# Use a server-only secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Azure OpenAI / Microsoft Foundry v1 endpoint. Do not use a GitHub token here.
# The deployment value is the Azure deployment name, not the public model name.
# These credentials are read once by the shared src/ai client and are never
# repeated in individual scripts or routes.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=replace_with_your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=replace_with_your_deployment_name

# Radio engine. The bucket remains private; the API returns short-lived signed URLs.
RADIO_AUDIO_BUCKET=radio-audio
FRAME_DELIVERY_LEAD_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=20
SESSION_HEARTBEAT_TIMEOUT_SECONDS=90
SESSION_HEARTBEAT_SWEEP_SECONDS=15
FRAME_POLL_RETRY_SECONDS=5
SIGNED_URL_EXPIRATION_SECONDS=3600
MAX_PENDING_DELIVERY_OPERATIONS_PER_SESSION=1
