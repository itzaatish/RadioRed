# Obtain these from Supabase Dashboard -> Connect / Settings -> API Keys.
# Use a server-only secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Azure OpenAI / Microsoft Foundry v1 endpoint. Do not use a GitHub token here.
# The deployment value is the Azure deployment name, not the public model name.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=replace_with_your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=replace_with_your_deployment_name
