{
  "schema": "public",
  "table": "songs",
  "columns": [
    { "name": "id", "type": "bigint", "identity": true, "primaryKey": true },
    { "name": "external_id", "type": "text", "notNull": true, "unique": true },

    { "name": "title", "type": "text", "notNull": true },
    { "name": "artist", "type": "text" },
    { "name": "album", "type": "text" },

    { "name": "audio_path", "type": "text", "notNull": true },
    { "name": "duration_seconds", "type": "integer" },

    { "name": "tone", "type": "integer", "notNull": true },

    { "name": "language", "type": "text", "default": "'en'" },
    { "name": "genre", "type": "text" },
    { "name": "mood", "type": "text" },

    { "name": "tags", "type": "jsonb", "notNull": true, "default": "'[]'" },
    { "name": "relationship_tags", "type": "jsonb", "notNull": true, "default": "'[]'" },

    { "name": "times_played", "type": "integer", "notNull": true, "default": "0" },
    { "name": "last_played_at", "type": "timestamptz" },

    { "name": "enabled", "type": "boolean", "notNull": true, "default": "true" },
    { "name": "created_at", "type": "timestamptz", "notNull": true, "default": "now()" },
    { "name": "updated_at", "type": "timestamptz", "notNull": true, "default": "now()" }
  ],
  "indexes": [
    { "columns": ["tone"] },
    { "columns": ["enabled"] },
    { "columns": ["last_played_at"] }
  ],
  "rls": false
}